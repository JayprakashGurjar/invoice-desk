PORT=4000

# ============================================================
# Extraction tools - ONLY for DATA_BACKEND=knex (offline development).
# With DATA_BACKEND=asmx, keys are entered on the Extraction tools page and stored
# encrypted in DS_AgreementTable by the web service; leave these empty.
# ============================================================
# Which tool reads documents when the user picks "Automatic":
#   auto | claude | gemini | openai | aws-textract | google-documentai | azure-docintel | basic
# "auto" uses the first tool that is set up, in that order of preference:
#   claude, azure-docintel, aws-textract, google-documentai, gemini, openai, basic
# Users can still choose any tool that is set up, per upload or when re-running.
EXTRACTION_PROVIDER=auto

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI GPT ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- AWS Textract (AnalyzeExpense) ---
# Credentials: set the keys below, or leave them empty to use your AWS profile / IAM role.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Needed only for multi-page PDFs (Textract reads those asynchronously from S3):
TEXTRACT_S3_BUCKET=
TEXTRACT_S3_PREFIX=invoicedesk/

# --- Google Cloud Document AI (Invoice Parser processor) ---
GOOGLE_DOCAI_PROJECT_ID=
GOOGLE_DOCAI_LOCATION=eu
GOOGLE_DOCAI_PROCESSOR_ID=
# Path to a service account key, or leave empty to use `gcloud auth application-default login`
GOOGLE_APPLICATION_CREDENTIALS=

# --- Azure AI Document Intelligence ---
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=
AZURE_DOCINTEL_MODEL=prebuilt-invoice
AZURE_DOCINTEL_API_VERSION=2024-11-30

# ============================================================
# Processing
# ============================================================
MAX_CONCURRENT_EXTRACTIONS=2
# Confidence below this marks a document "needs review"
REVIEW_CONFIDENCE_THRESHOLD=0.75

# ============================================================
# Data layer
# ============================================================
#   knex - talk to the database directly (SQLite by default, or SQL Server below)
#   asmx - call the DocuSoft PracticeServices web services, which run the
#          invoicedesk.* stored procedures in the client database (recommended).
#   knex - talk to a database directly (SQLite for offline development).
DATA_BACKEND=asmx

# --- ASMX web services (DATA_BACKEND=asmx) ---
# Full URL of the .asmx file
ASMX_URL=https://accountancy.docusoftweb.com/PracticeServices.asmx
# Users sign in to the React app with their own DocuSoft login (agreement number, email,
# password); every web-service call is made with that user's login. Extraction runs in the
# web service with the keys stored, encrypted, in DS_AgreementTable - so with asmx the
# provider keys in the "Extraction tools" section above are NOT used and should stay empty.
#
# Optional service account: if set, its agreement's interrupted documents are resumed when
# the API starts (otherwise each agreement resumes when one of its users signs in).
ASMX_AGRNO=
ASMX_EMAIL=
ASMX_PASSWORD=
# Offline testing without the live service: run `npm run mock-asmx` and use
#   ASMX_URL=http://localhost:4100/PracticeServices.asmx
# then sign in with agreement DEMO, password demo, and demo@docusoft.net or approver@docusoft.net
ASMX_TIMEOUT_MS=60000
# Extraction calls AI services from the web service, so it gets longer
ASMX_EXTRACTION_TIMEOUT_MS=240000

# --- Direct database (DATA_BACKEND=knex): sqlite or mssql ---
DB_CLIENT=sqlite
SQLITE_PATH=./data/invoicedesk.db

MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_DATABASE=InvoiceDesk
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
